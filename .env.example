# Outline API Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# Your Outline API key (get from Settings → API & Apps)
OUTLINE_API_KEY=your_api_key_here

# Outline API URL (use default for cloud-hosted Outline)
OUTLINE_API_URL=https://app.getoutline.com/api

# Collection ID to compile
OUTLINE_COLLECTION_ID=your_collection_uuid_here

# Base folder where the cron runner (run_all.py) writes one subfolder per
# collection. Defaults to ~/outline-exports if unset.
OUTLINE_EXPORT_DIR=~/outline-exports
